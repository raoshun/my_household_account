{
  "name": "my-table-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "test:ci": "react-scripts test --watchAll=false --ci",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:watch": "react-scripts test --coverage",
    "test:update": "react-scripts test --updateSnapshot",
    "test:find-non-covered": "react-scripts test --coverage --watchAll=false --coverageReporters=\"json-summary\" && node ./scripts/find-non-covered.js",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^27.5.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/testing-library__jest-dom": "^5.9.5",
    "jest": "^27.5.1",
    "jest-environment-node": "^27.5.1",
    "msw": "^2.7.5",
    "react-scripts": "^5.0.1",
    "typescript": "^5.8.3"
  }
}
