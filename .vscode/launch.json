{
    "configurations": [
        {
            "type": "node",
            "name": "Node: Debug Current Test",
            "request": "launch",
            "runtimeExecutable": "${workspaceFolder}/my-table-app/node_modules/.bin/react-scripts",
            "args": [
                "test",
                "${relativeFile}",
                "--runInBand",
                "--no-cache",
                "--watchAll=false",
                "--verbose"
            ],
            "cwd": "${workspaceFolder}/my-table-app",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "env": {
                "TEST_DEBUG": "true"
            }
        },
        {
            "type": "node",
            "name": "Node: Debug Single Test",
            "request": "launch",
            "runtimeExecutable": "${workspaceFolder}/my-table-app/node_modules/.bin/react-scripts",
            "args": [
                "test",
                "--testNamePattern",
                "${input:testName}",
                "--runInBand",
                "--no-cache",
                "--watchAll=false",
                "--verbose"
            ],
            "cwd": "${workspaceFolder}/my-table-app",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "env": {
                "TEST_DEBUG": "true"
            }
        },
        {
            "type": "node",
            "name": "Node: Debug All Tests",
            "request": "launch",
            "runtimeExecutable": "${workspaceFolder}/my-table-app/node_modules/.bin/react-scripts",
            "args": [
                "test",
                "--runInBand",
                "--no-cache",
                "--watchAll=false",
                "--verbose"
            ],
            "cwd": "${workspaceFolder}/my-table-app",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "env": {
                "TEST_DEBUG": "true"
            }
        },
        {
            "type": "node",
            "name": "Debug Tests",
            "request": "launch",
            "name": "Launch React App",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/${input:reactAppFolder}",
            "preLaunchTask": "react-app-start",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Python: API Server",
            "type": "python",
            "request": "launch",
            "module": "my_household_analysis.api.rest_server",
            "args": ["${input:apiServerArgs}"],
            "cwd": "${workspaceFolder}/my_household_analysis",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "envFile": "${workspaceFolder}/my_household_analysis/.env"
        },
        {
            "name": "Python: Test Current File",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-v"
            ],
            "cwd": "${workspaceFolder}/my_household_analysis",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python: Test All",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/",
                "-v"
            ],
            "cwd": "${workspaceFolder}/my_household_analysis",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Full Stack: API + React",
            "type": "python",
            "request": "launch",
            "module": "my_household_analysis.api.rest_server",
            "args": [],
            "cwd": "${workspaceFolder}/my_household_analysis",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "preLaunchTask": "react-app-start",
            "envFile": "${workspaceFolder}/my_household_analysis/.env"
        }
    ],
    "inputs": [
        {
            "type": "pickString",
            "id": "reactAppFolder",
            "description": "Select the React application folder",
            "options": [
                "my-table-app"
            ],
            "default": "my-table-app"
        },
        {
            "id": "testName",
            "type": "promptString",
            "description": "テスト名を入力してください (正規表現を使用可能)",
            "default": "renders"
        },
        {
            "id": "portNumber",
            "type": "promptString",
            "description": "APIサーバーのポート番号を入力してください",
            "default": "8000"
        },
        {
            "id": "browserType",
            "type": "pickString",
            "description": "使用するブラウザを選択してください",
            "options": [
                "msedge",
                "chrome",
                "firefox"
            ],
            "default": "chrome"
        },
        {
            "id": "apiServerArgs",
            "type": "pickString",
            "description": "APIサーバーの起動オプション",
            "options": [
                "",
                "--port ${input:portNumber}"
            ],
            "default": ""
        }
    ]
}